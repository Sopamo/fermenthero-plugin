                    "name": {
                      "type": "string"
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "name_scalable": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "note_scalable": {
                      "type": [
